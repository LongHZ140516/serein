---
interface Props {
    title: string
    subtitle?: string
    dateRange: string
    logo?: string
    description?: string
}

const { title, subtitle, dateRange, logo, description } = Astro.props
---

<div class="timeline-item group relative flex gap-4 pb-8 last:pb-0">
    {/* Timeline line */}
    <div
        class="bg-border absolute top-12 left-6 h-[calc(100%-3rem)] w-px group-last:hidden"
    >
    </div>

    {/* Logo / Icon */}
    <div class="relative z-10 flex-shrink-0">
        {
            logo ? (
                <img
                    src={logo}
                    alt={title}
                    class="border-border bg-card size-12 rounded-xl border object-contain p-1 shadow-sm"
                    loading="lazy"
                />
            ) : (
                <div class="border-border bg-card text-muted-foreground flex size-12 items-center justify-center rounded-xl border shadow-sm">
                    <svg
                        class="size-5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"
                        />
                    </svg>
                </div>
            )
        }
    </div>

    {/* Content */}
    <div class="flex-grow pt-1">
        <h3 class="text-base font-semibold">{title}</h3>
        {subtitle && <p class="text-muted-foreground text-sm">{subtitle}</p>}
        <p class="text-muted-foreground/70 mt-1 text-xs">{dateRange}</p>
        {
            description && (
                <p class="text-muted-foreground mt-2 text-sm">{description}</p>
            )
        }
    </div>
</div>
