---
import { Image } from 'astro:assets'
import type { CollectionEntry } from 'astro:content'

interface Props {
    item: CollectionEntry<'media'>
}

const { item } = Astro.props
const { title, cover, url } = item.data

// Check if cover is a URL string or an image object
const isUrlCover = typeof cover === 'string'
---

<a
    href={url || '#'}
    target={url ? '_blank' : undefined}
    rel={url ? 'noopener noreferrer' : undefined}
    class="media-card group relative block aspect-[2/3] overflow-hidden rounded-xl"
    title={title}
>
    {/* Cover Image */}
    {
        isUrlCover ? (
            <img
                src={cover}
                alt={title}
                class="h-full w-full object-cover"
                style="display: block;"
                loading="lazy"
            />
        ) : (
            <Image
                src={cover}
                alt={title}
                width={300}
                height={450}
                class="h-full w-full object-cover"
                style="display: block;"
                loading="lazy"
            />
        )
    }
</a>

<style>
    .media-card {
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.1);
        transition:
            transform 0.2s ease,
            box-shadow 0.2s ease;
    }

    .media-card:hover {
        transform: scale(1.02);
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.15);
    }

    .media-card img {
        display: block;
        margin: 0;
        padding: 0;
    }

    .dark .media-card {
        box-shadow: 0 2px 8px -2px rgba(0, 0, 0, 0.2);
    }

    .dark .media-card:hover {
        box-shadow: 0 8px 16px -4px rgba(0, 0, 0, 0.3);
    }
</style>
