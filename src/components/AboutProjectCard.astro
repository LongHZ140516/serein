---
import Link from '@/components/Link.astro'
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'

interface Props {
    name: string
    description?: string
    image: ImageMetadata | string
    url: string
    githubRepo?: string // Optional: e.g., "LongHZ140516/KokoroMate"
}

const { name, description, image, url, githubRepo } = Astro.props

// Check if image is a URL string or an image object
const isUrlImage = typeof image === 'string'

// Fetch GitHub stars if repo is specified
let starCount: number | null = null
if (githubRepo) {
    try {
        const response = await fetch(
            `https://api.github.com/repos/${githubRepo}`,
            {
                headers: {
                    Accept: 'application/vnd.github.v3+json',
                    'User-Agent': 'Astro-Site',
                },
            },
        )
        if (response.ok) {
            const data = await response.json()
            starCount = data.stargazers_count
        }
    } catch (e) {
        // Silently fail if API call fails
    }
}
---

<Link
    href={url}
    class="group/card border-border bg-card hover:bg-secondary/30 hover:border-primary/20 relative flex flex-col overflow-hidden rounded-xl border transition-colors duration-200"
    external
>
    {/* Thumbnail */}
    <div class="aspect-video overflow-hidden">
        {
            isUrlImage ? (
                <img
                    src={image}
                    alt={name}
                    class="size-full object-cover transition-transform duration-300 group-hover/card:scale-[1.02]"
                    loading="lazy"
                />
            ) : (
                <Image
                    src={image}
                    alt={name}
                    width={800}
                    height={450}
                    class="size-full object-cover transition-transform duration-300 group-hover/card:scale-[1.02]"
                    loading="lazy"
                />
            )
        }
    </div>

    {/* Content */}
    <div class="flex flex-grow flex-col justify-between p-4">
        <div>
            <div class="mb-1 flex items-center gap-2">
                <h3
                    class="group-hover/card:text-primary text-base font-semibold transition-colors"
                >
                    {name}
                </h3>
                {
                    starCount !== null && (
                        <span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-700 dark:bg-amber-900/20 dark:text-amber-400">
                            <svg
                                class="size-3 fill-amber-400"
                                viewBox="0 0 24 24"
                            >
                                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z" />
                            </svg>
                            {starCount}
                        </span>
                    )
                }
            </div>
            {
                description && (
                    <p class="text-muted-foreground line-clamp-2 text-sm">
                        {description}
                    </p>
                )
            }
        </div>
    </div>
</Link>
